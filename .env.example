# Copy this file to .env and replace both secrets before starting the app.
TODO_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=false
NODE_ENV=production

# AI bulk import. Keep this key on the server; never put it in public/app.js.
AI_API_KEY=
AI_API_STYLE=responses
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
